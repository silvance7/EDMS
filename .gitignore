# ═══════════════════════════════════════════════════════════════════════
#  .gitignore —— 电子元器件库存管理系统（EDMS）
#
#  原则：仓库里只留「源码 + 测试 + 构建配置 + 文档」。
#  环境、运行数据、打包产物、本地工作资料一律不进版本库。
#  每条规则都写了原因，改动之前先读注释。
# ═══════════════════════════════════════════════════════════════════════

# ── 1. Python 环境 ────────────────────────────────────────────────────
# 虚拟环境（uv / venv 建的都叫这个名字）。clone 之后用
# `uv sync` 或 `python -m venv` 重建，绝不要提交。
.venv/
venv/

# Python 字节码缓存。跨 Python 版本不通用，解释器会自动重新生成。
__pycache__/
*.py[cod]

# 打包 / 安装产生的元数据
*.egg-info/
.eggs/

# ── 2. 依赖与锁 ───────────────────────────────────────────────────────
# 注意：uv.lock 是**要提交的**（应用项目惯例：锁死可复现的版本）。
# 这里只忽略本机的离线 wheel 仓库（约 74MB，本机 pip 被拦截时离线装包用）。
# 目录里的 .gitkeep 保留目录本身 —— uv 的 find-links 指向不存在的目录会报错，
# clone 后空目录正好让 uv 正常走 PyPI 安装。
.wheels/*
!.wheels/.gitkeep

# ── 3. 运行数据（data/ 与 exe / 源码同级，见 app/paths.py）──────────────
# SQLite 数据库本体 + WAL / SHM 两个运行期临时文件
data/*.db
data/*.db-wal
data/*.db-shm
# 数据库热备份（「手动备份」功能生成的 *.bak-日期时间）
data/*.bak-*
# 本地设置：热键、主题、上次目录等。按机器而异，不共享
data/settings.json

# 运行日志（info / error 两份，按天滚动）
log/

# ── 4. 打包产物 ───────────────────────────────────────────────────────
# 绿色便携版（60MB+）。要发布就发 GitHub Release，不进仓库
dist/
# PyInstaller 的中间产物目录；但「打包配置本身」要发布，见两条例外
build/*
!build/build_portable.spec
!build/icon.ico

# ── 5. 私人数据 ───────────────────────────────────────────────────────
# 自己的 BOM 文件：用户真实清单 + 测试清单（测试那份可由
# .workbuddy/tools/test_data.py 重新生成），都不公开
Bom/
# AI 协作的交接文档：记录开发过程与内部决策，本地工作用
progress.md

# ── 6. WorkBuddy AI 工作区（本地开发资料）────────────────────────────
# 记忆、截图、dist 数据备份、一次性调试脚本都在这里，属于本地资料，不发布。
.workbuddy/*
# 例外：开发与测试脚本保留发布 —— README「开发与测试」一节要用，
# 别人 clone 之后能跑同一套冒烟测试与界面测试。
!.workbuddy/tools/
